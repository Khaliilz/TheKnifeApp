<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>

<StackPane stylesheets="@css/restaurateurHomeStyle.css" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lab.controller.NewRestaurantController">
    <HBox fx:id="columnsArea" spacing="15">
      <VBox fx:id="col1" alignment="TOP_LEFT" spacing="25" maxWidth="590" HBox.hgrow="ALWAYS">
        <VBox alignment="CENTER_LEFT" spacing="15">
          <Text text="Nome:" styleClass="lables"/>
          <TextField fx:id="name" styleClass="defaultTextField" maxWidth="350" alignment="CENTER"/>
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="15">
          <VBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
            <Text text="Indirizzo:" styleClass="lables"/>
            <TextField fx:id="address" styleClass="defaultTextField" alignment="CENTER"/>
          </VBox>
          <VBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
            <Text text="Citta':" styleClass="lables"/>
            <TextField fx:id="city" styleClass="defaultTextField" alignment="CENTER"/>
          </VBox>
          <VBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
            <Text text="Nazione:" styleClass="lables"/>
            <TextField fx:id="country" styleClass="defaultTextField" alignment="CENTER"/>
          </VBox>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15">
          <VBox alignment="CENTER_LEFT" spacing="15">
            <Text text="Latitudine:" styleClass="lables"/>
            <TextField fx:id="latitude" styleClass="defaultTextField" maxWidth="250" alignment="CENTER"/>
          </VBox>
          <VBox alignment="CENTER_LEFT" spacing="15">
            <Text text="Longitudine:" styleClass="lables"/>
            <TextField fx:id="longitude" styleClass="defaultTextField" prefWidth="250" alignment="CENTER"/>
          </VBox>
        </HBox>

        <VBox alignment="CENTER_LEFT" spacing="15">
          <Text text="Cucina:" styleClass="lables"/>
          <TextField fx:id="cuisine" styleClass="defaultTextField" maxWidth="350" alignment="CENTER"/>
        </VBox>
      </VBox>

      <VBox fx:id="col2" spacing="25" alignment="CENTER" maxWidth="590" HBox.hgrow="ALWAYS">
        <Pane minHeight="25"/>

        <Text text="Delivery:" styleClass="lables"/>
        <HBox alignment="CENTER" spacing="15">
          <RadioButton fx:id="yesDelivery" styleClass="defaultRadioButton" text="Si" selected="true">
            <toggleGroup>
              <ToggleGroup fx:id="deliveryGroup"/>
            </toggleGroup>
          </RadioButton>
          <RadioButton fx:id="noDelivery" styleClass="defaultRadioButton" text="No" toggleGroup="$deliveryGroup"/>
        </HBox>

        
        <Text text="Prenotazioni:" styleClass="lables"/>
        <HBox alignment="CENTER" spacing="15">
          <RadioButton fx:id="yesBooking" styleClass="defaultRadioButton" text="Si" selected="true">
            <toggleGroup>
              <ToggleGroup fx:id="bookingGroup"/>
            </toggleGroup>
          </RadioButton>
          <RadioButton fx:id="noBooking" styleClass="defaultRadioButton" text="No" toggleGroup="$bookingGroup"/>
        </HBox>

        <Text text="Fascia prezzo:" styleClass="lables"/>
        <HBox alignment="CENTER" spacing="15">
          <RadioButton fx:id="priceOne" styleClass="defaultRadioButton" text="10-20" selected="true">
            <toggleGroup>
              <ToggleGroup fx:id="priceGroup"/>
            </toggleGroup>
          </RadioButton>
          <RadioButton fx:id="priceTwo" styleClass="defaultRadioButton" text="30-40" toggleGroup="$priceGroup"/>
          <RadioButton fx:id="priceThree" styleClass="defaultRadioButton" text="50-60" toggleGroup="$priceGroup"/>
          <RadioButton fx:id="priceFour" styleClass="defaultRadioButton" text="70-80" toggleGroup="$priceGroup"/>
        </HBox>

        <Pane VBox.vgrow="ALWAYS"/>

        <HBox alignment="CENTER" spacing="20">
          <Button fx:id="cancel" styleClass="redButton" text="ANNULLA" prefWidth="120" prefHeight="50" onAction="#cancelClicked"/>
          <Button fx:id="save" styleClass="greenButton" text="SALVA" prefWidth="120" prefHeight="50" onAction="#saveClicked"/>
        </HBox>
      </VBox>
    </HBox>
</StackPane>