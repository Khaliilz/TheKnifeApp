<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>

<StackPane stylesheets="@/com/lab/css/theKnifeStyle.css" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lab.controller.restaurateur.NewRestaurantController">
    <HBox fx:id="columnsArea" spacing="15">
      <VBox fx:id="col1" alignment="TOP_LEFT" spacing="25" maxWidth="590" HBox.hgrow="ALWAYS">
        <VBox alignment="CENTER_LEFT" spacing="15">
          <Text text="Nome:" styleClass="labels"/>
          <TextField fx:id="name" styleClass="defaultTextField" maxWidth="350" alignment="CENTER"/>
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="15">
          <VBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
            <Text text="Indirizzo:" styleClass="labels"/>
            <TextField fx:id="address" styleClass="defaultTextField" promptText="Via Roma, 12" alignment="CENTER"/>
          </VBox>
          <VBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
            <Text text="Citta':" styleClass="labels"/>
            <TextField fx:id="city" styleClass="defaultTextField" promptText="Lazio" alignment="CENTER"/>
          </VBox>
          <VBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
            <Text text="Nazione:" styleClass="labels"/>
            <TextField fx:id="country" styleClass="defaultTextField" promptText="Italia" alignment="CENTER"/>
          </VBox>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15">
          <VBox alignment="CENTER_LEFT" spacing="15">
            <Text text="Latitudine:" styleClass="labels"/>
            <TextField fx:id="latitude" styleClass="defaultTextField" promptText="41.893" maxWidth="250" alignment="CENTER"/>
          </VBox>
          <VBox alignment="CENTER_LEFT" spacing="15">
            <Text text="Longitudine:" styleClass="labels"/>
            <TextField fx:id="longitude" styleClass="defaultTextField" promptText="12.483" prefWidth="250" alignment="CENTER"/>
          </VBox>
        </HBox>

        <VBox alignment="CENTER_LEFT" spacing="15">
          <Text text="Cucina:" styleClass="labels"/>
          <TextField fx:id="cuisine" styleClass="defaultTextField" promptText="Mediterranea, orientale" maxWidth="350" alignment="CENTER"/>
        </VBox>
      </VBox>

      <VBox fx:id="col2" spacing="25" alignment="CENTER" maxWidth="590" HBox.hgrow="ALWAYS">
        <VBox alignment="CENTER" spacing="15">
          <Text text="Delivery (Facoltativo):" styleClass="labels"/>
          <TextField fx:id="phoneNumber" styleClass="defaultTextField" promptText="+001234567890" maxWidth="350" alignment="CENTER"/>
        </VBox>

        <VBox alignment="CENTER" spacing="15">
          <Text text="Prenotazioni (Facoltativo):" styleClass="labels"/>
          <TextField fx:id="websiteUrl" styleClass="defaultTextField" promptText="https://www.il-mio-ristorante.com" maxWidth="350" alignment="CENTER"/>
        </VBox>

        <Text text="Fascia prezzo:" styleClass="labels"/>
        <HBox alignment="CENTER" spacing="15">
          <fx:define>
            <ToggleGroup fx:id="priceGroup"/>
          </fx:define>

          <RadioButton fx:id="priceOne" styleClass="defaultRadioButton" text="10-20" selected="true" toggleGroup="$priceGroup"/>
          <RadioButton fx:id="priceTwo" styleClass="defaultRadioButton" text="30-40" toggleGroup="$priceGroup"/>
          <RadioButton fx:id="priceThree" styleClass="defaultRadioButton" text="50-60" toggleGroup="$priceGroup"/>
          <RadioButton fx:id="priceFour" styleClass="defaultRadioButton" text="70-80" toggleGroup="$priceGroup"/>
        </HBox>

        <Pane VBox.vgrow="ALWAYS"/>

        <HBox alignment="CENTER" spacing="20">
          <Button fx:id="cancel" styleClass="redButton" text="ANNULLA" prefWidth="120" prefHeight="50" onAction="#cancelClicked"/>
          <Button fx:id="save" styleClass="greenButton" text="SALVA" prefWidth="120" prefHeight="50" onAction="#saveClicked"/>
        </HBox>
      </VBox>
    </HBox>
</StackPane>