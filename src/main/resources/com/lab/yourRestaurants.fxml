<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.Label?>

<HBox fx:id="row" alignment="CENTER_LEFT" stylesheets="@css/restaurateurHomeStyle.css" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lab.controller.YourRestaurantsController">
  <HBox alignment="CENTER_LEFT" spacing="15">
    <Text fx:id="name" styleClass="lables" text="Default name"/>
    <Label fx:id="address" styleClass="infos" maxWidth="300" minWidth="300" text="Default address"/>
  </HBox>

  <Pane prefWidth="50"/>
  
  <HBox alignment="CENTER_LEFT" spacing="15">
    <Text fx:id="starsNum" styleClass="infos" text="value"/>
    <Text fx:id="stars" styleClass="lables" text="Stelle"/>
    <Text fx:id="reviewsNum" styleClass="infos" text="value"/>
    <Text fx:id="reviews" styleClass="lables" text="Recensioni"/>
  </HBox>

  <Pane HBox.hgrow="ALWAYS"/>

  <Button fx:id="detail" styleClass="button" text="Dettagli" prefWidth="120" prefHeight="40" onAction="#detailClicked"/>
</HBox>