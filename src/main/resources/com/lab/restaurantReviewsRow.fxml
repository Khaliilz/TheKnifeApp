<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<HBox fx:id="row" alignment="CENTER_LEFT"  spacing="15" stylesheets="@css/restaurateurHomeStyle.css" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lab.controller.RestaurantReviewsRowController">
  <VBox spacing="5">
    <HBox alignment="CENTER_LEFT" spacing="15" maxWidth="450" minWidth="450" >
      <Text fx:id="name" styleClass="lables" text="Default name"/>
      <Label fx:id="address" styleClass="infos" text="Default address"/>
    </HBox>
    
    <HBox alignment="CENTER_LEFT" spacing="5">
      <Text fx:id="starsNum" styleClass="infos" text="value"/>
      <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
        <image>
          <Image url="@img/starIcon.png" />
        </image>
      </ImageView>

      <Pane minWidth="10"/>

      <Text fx:id="comment" styleClass="infos" text="Default comment"/>
    </HBox>
  </VBox>

  <Pane HBox.hgrow="ALWAYS"/>

  <Button fx:id="detail" styleClass="greenButton" text="VISUALIZZA" prefWidth="150" prefHeight="40" onAction="#viewClicked"/>
</HBox>