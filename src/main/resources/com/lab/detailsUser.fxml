<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@css/theKnifeStyle.css" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lab.controller.DetailsUserController">
  <children>
    <VBox alignment="CENTER" spacing="30" AnchorPane.topAnchor="5" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="15">
      <Text fx:id="name_L" styleClass="subTitle" text="Name"/>

      <HBox alignment="CENTER" spacing="30" VBox.vgrow="ALWAYS">
        <VBox spacing="15" minWidth="320">
          <HBox spacing="5">
            <Label styleClass="labels" text="Indirizzo:"/>
            <Label fx:id="address_L" styleClass="infos" text="Address"/>
          </HBox>
          <HBox spacing="5">
            <Label styleClass="labels" text="Prezzo:"/>
            <Label fx:id="price_L" styleClass="infos" text="Price"/>
          </HBox>
          <HBox spacing="5">
            <Label styleClass="labels" text="Delivery:"/>
            <Label fx:id="delivery_L" styleClass="infos" text="yes"/>
          </HBox>
          <HBox spacing="5">
            <Label styleClass="labels" text="Prenotazioni:"/>
            <Label fx:id="booking_L" styleClass="infos" text="yes"/>
          </HBox>
          <HBox spacing="5">
            <Label styleClass="labels" text="Tipo di cucina:"/>
            <Label fx:id="cuisine_L" styleClass="infos" text="Type of cuisine"/>
          </HBox>
        </VBox>

        <StackPane styleClass="container" maxHeight="250">
          <ScrollPane fx:id="listContainer" fitToWidth="true" vbarPolicy="AS_NEEDED" pannable="true">
            <VBox fx:id="listOfComments"/>
          </ScrollPane>
        </StackPane>
      </HBox>

      <HBox alignment="CENTER_RIGHT" spacing="20">
        <Button fx:id="reviewButton" styleClass="greenButton" text="RECENSISCI" prefWidth="120" prefHeight="40" onAction="#reviewClicked"/>
        <Button styleClass="greenButton" text="INDIETRO" prefWidth="120" prefHeight="40" onAction="#backClicked"/>
      </HBox>
    </VBox>
  </children>
</AnchorPane>