<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@css/leftMenuAreaStyle.css" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lab.controller.DetailsUserController">
  <children>
    <VBox alignment="CENTER" spacing="30" AnchorPane.topAnchor="5" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="15">
      <Text fx:id="name_L" text="Name"/>

      <HBox alignment="CENTER" spacing="30" VBox.vgrow="ALWAYS">
        <VBox spacing="15" minWidth="320">
          <HBox spacing="5">
            <Label styleClass="titleLabel" text="Indirizzo:"/>
            <Label fx:id="address_L" styleClass="textLabel" text="Address"/>
          </HBox>
          <HBox spacing="5">
            <Label styleClass="titleLabel" text="Prezzo:"/>
            <Label fx:id="price_L" styleClass="textLabel" text="Price"/>
          </HBox>
          <HBox spacing="5">
            <Label styleClass="titleLabel" text="Delivery:"/>
            <Label fx:id="delivery_L" styleClass="textLabel" text="yes"/>
          </HBox>
          <HBox spacing="5">
            <Label styleClass="titleLabel" text="Prenotazioni:"/>
            <Label fx:id="booking_L" styleClass="textLabel" text="yes"/>
          </HBox>
          <HBox spacing="5">
            <Label styleClass="titleLabel" text="Tipo di cucina:"/>
            <Label fx:id="cousine_L" styleClass="textLabel" text="Type of cousine"/>
          </HBox>
        </VBox>

        <StackPane styleClass="container">
          <ScrollPane styleClass="listContainer_SP" fitToWidth="true" vbarPolicy="AS_NEEDED" pannable="true">
            <VBox fx:id="listOfComments" spacing="15"/>
          </ScrollPane>
        </StackPane>
      </HBox>

      <HBox alignment="CENTER_RIGHT" spacing="20">
        <Button styleClass="detailButton" text="RECENSISCI" prefWidth="120" prefHeight="40" onAction="#reviewClicked"/>
        <Button styleClass="detailButton" text="INDIETRO" prefWidth="120" prefHeight="40" onAction="#backClicked"/>
      </HBox>
    </VBox>
  </children>
</AnchorPane>