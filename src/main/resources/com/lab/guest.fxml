<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefWidth="1280" prefHeight="700" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lab.controller.GuestController">
  <children>

    <VBox alignment="CENTER" spacing="25" AnchorPane.topAnchor="250" AnchorPane.leftAnchor="500" AnchorPane.rightAnchor="500">
      <VBox alignment="CENTER_LEFT" spacing="5">
        <Label styleClass="theknifeLabel" text="Domicilio:"/>
        <TextField fx:id="luogo_TF" styleClass="theknifeInput" prefWidth="230" prefHeight="70" alignment="CENTER"/>
      </VBox>

      <StackPane prefHeight="40"/> 

      <Button fx:id="cerca_B" styleClass="theknifeButton" prefWidth="230" prefHeight="70" onAction="#cercaClicked">
        <graphic>
          <Text styleClass="theknifeText" text="CERCA"/>
        </graphic>
      </Button>
    </VBox>
    
  </children>
</AnchorPane>