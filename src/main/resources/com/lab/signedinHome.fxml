<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefWidth="1280" prefHeight="700" stylesheets="@css/signedinStyle.css" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lab.controller.SignedinHomeController">
  <children>
    <VBox spacing="30" AnchorPane.topAnchor="255" AnchorPane.leftAnchor="30" prefWidth="200">

      <Button styleClass="detailButton" prefWidth="170" prefHeight="40" onAction="#searchClicked"> 
        <graphic> 
          <Text styleClass="textInButtons" text="Cerca"/> 
        </graphic> 
      </Button> 

      <Button styleClass="detailButton" prefWidth="170" prefHeight="40" onAction="#bookmarkClicked"> 
        <graphic> 
          <Text styleClass="textInButtons" text="Preferiti"/> 
        </graphic> 
      </Button> 

      <Button styleClass="detailButton" prefWidth="170" prefHeight="40" onAction="#reviewClicked"> 
        <graphic> 
          <Text styleClass="textInButtons" text="Recensiti"/> 
        </graphic> 
      </Button> 
    </VBox>

    
    <Label text="Ristoranti nelle vicinanze" alignment="CENTER" AnchorPane.topAnchor="50" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
      <font>
        <Font name="Impact" size="40"/>
      </font>
    </Label>

    <ScrollPane fx:id="listContainer_SP" fitToWidth="true" AnchorPane.topAnchor="150" AnchorPane.bottomAnchor="50" AnchorPane.leftAnchor="240" AnchorPane.rightAnchor="30">
      <VBox fx:id="listOfRestaurants_VB" spacing="10"/>
    </ScrollPane>

  </children>
</AnchorPane>