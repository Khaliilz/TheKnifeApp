<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefWidth="1280" prefHeight="700" stylesheets="@/com/lab/css/theKnifeStyle.css" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lab.controller.restaurateur.RestaurateurHomeController">
  <children>
    <StackPane alignment="CENTER" AnchorPane.topAnchor="50" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
      <Text fx:id="title" text="Default title"/>
    </StackPane>
    
    <StackPane fx:id="contentArea" AnchorPane.topAnchor="150" AnchorPane.bottomAnchor="50" AnchorPane.leftAnchor="50" AnchorPane.rightAnchor="50">      
      <VBox fx:id="mainArea" alignment="CENTER" minHeight="450" maxHeight="450">
      
        <Label fx:id="emptyLabel" text="Nessun ristorante presente al momento" visible="false" managed="false"/>
        <ScrollPane fx:id="listContainer" fitToWidth="true" VBox.vgrow="ALWAYS" pannable="true">
          <VBox fx:id="list" spacing="10"/>
        </ScrollPane>

        <Pane fx:id="spacer" prefHeight="15"/>

        <Button fx:id="add" styleClass="greenButton" text="AGGIUNGI" prefWidth="120" minHeight="50" onAction="#addClicked"/>
      </VBox>
    </StackPane>
  </children>
</AnchorPane>